<UserControl x:Class="PcSante.App.Views.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PcSante.App.Controls"
             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
    <!-- Indicateur d'activité : l'utilisateur voit que l'action est en cours (voile du fond + carte centrale). -->
    <Grid>
        <Border Background="{DynamicResource PcsBackgroundBrush}" Opacity="0.82" />
        <Border Style="{StaticResource PcsCard}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,28" MaxWidth="480">
            <StackPanel>
                <c:Spinner Width="48" Height="48" Thickness="5" Stroke="{DynamicResource PcsBrandBrush}" TrackBrush="{DynamicResource PcsRingTrackBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource PcsText.RowTitle}" Margin="0,18,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
