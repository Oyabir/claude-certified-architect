<ui:FluentWindow x:Class="PcSante.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:PcSante.App.Localization"
                 xmlns:vm="clr-namespace:PcSante.App.ViewModels"
                 xmlns:v="clr-namespace:PcSante.App.Views"
                 xmlns:infra="clr-namespace:PcSante.App.Infrastructure"
                 Title="{Binding ProductName}"
                 Width="1180" Height="780" MinWidth="900" MinHeight="600"
                 FontSize="14"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/pcsante.ico">
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProtectionViewModel}"><v:ProtectionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationViewModel}"><v:OptimizationView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}"><v:PerformanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}"><v:ProcessesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}"><v:SystemView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SchedulingViewModel}"><v:SchedulingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicenseViewModel}"><v:LicenseView /></DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding ProductName}" />

        <!-- Premier lancement : assistant en 3 étapes. -->
        <v:WelcomeView Grid.Row="1" DataContext="{Binding Welcome}"
                       Visibility="{Binding DataContext.ShowWelcome, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

        <Grid Grid.Row="1" Visibility="{Binding ShowWelcome, Converter={StaticResource Collapsed}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation latérale -->
            <DockPanel Grid.Column="0" Margin="8,4,8,12" LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Margin="12,8" Padding="10,6" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:T Nav_Offer}" Style="{StaticResource Technical}" />
                            <TextBlock Text="{Binding LicenseBadge}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding FooterItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                           Padding="12,10" Margin="0,2"
                                           Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding Screen}"
                                           AutomationProperties.Name="{Binding Label}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding Label}" FontSize="15" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="{l:T Nav_Menu}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="4,8" AutomationProperties.Name="{Binding Label}">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Label}" FontSize="16" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Contenu -->
            <Grid Grid.Column="1" Margin="8,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Service injoignable : message clair et action proposée. -->
                <Border Grid.Row="0" Background="{x:Static infra:HealthBrushes.Red}" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                        Visibility="{Binding ServiceAvailable, Converter={StaticResource Collapsed}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="{l:T Common_Retry}" Command="{Binding RetryServiceCommand}" Appearance="Light" />
                        <StackPanel>
                            <TextBlock Text="{l:T Service_Unavailable}" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{l:T Service_UnavailableHelp}" Foreground="White" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Message de résultat après chaque action (jamais de silence). -->
                <ui:InfoBar Grid.Row="1" Margin="0,0,0,12"
                            IsOpen="{Binding Message.IsOpen, Mode=TwoWay}"
                            Severity="{Binding Message.Severity}"
                            Title="{Binding Message.Text}"
                            IsClosable="True"
                            AutomationProperties.LiveSetting="Assertive">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{l:T Common_Details}" Appearance="Transparent" Command="{Binding ToggleDetailsCommand}"
                                       Visibility="{Binding Message.HasDetails, Converter={StaticResource Visible}}" />
                            <ui:Button Content="{l:T License_GetPremium}" Appearance="Primary" Command="{Binding GoToLicenseCommand}"
                                       Visibility="{Binding Message.SuggestPremium, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <TextBox Text="{Binding Message.Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,0"
                                 FontFamily="Consolas" FontSize="13"
                                 Visibility="{Binding Message.ShowDetails, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </ui:InfoBar>

                <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
