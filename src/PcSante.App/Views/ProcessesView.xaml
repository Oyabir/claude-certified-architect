<UserControl x:Class="PcSante.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:vm="clr-namespace:PcSante.App.ViewModels"
             xmlns:v="clr-namespace:PcSante.App.Views">
    <Grid>
        <Grid Margin="40,28,40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
            <ui:Button Grid.Row="2" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Left" Content="{l:T Process_Refresh}"
                       Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" Margin="0,0,0,12" />

            <DataGrid Grid.Row="3" ItemsSource="{Binding Processes}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="True" HeadersVisibility="Column" SelectionMode="Single"
                      AutomationProperties.Name="{l:T Nav_Processes}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{l:T Process_Name}" SortMemberPath="Name" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Technical}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T Process_Cpu}" Binding="{Binding Cpu, StringFormat={}{0:0.#} %}" SortMemberPath="Cpu" Width="80" />
                    <DataGridTextColumn Header="{l:T Process_Memory}" Binding="{Binding Memory}" SortMemberPath="MemoryBytes" Width="100" />
                    <DataGridTextColumn Header="{l:T Process_Disk}" Binding="{Binding Disk}" Width="100" />
                    <DataGridTextColumn Header="{l:T Process_Network}" Binding="{Binding Network}" Width="100" />
                    <DataGridTemplateColumn Header="{l:T Process_Reputation}" SortMemberPath="Reputation" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ProcessRow}">
                                <Border Style="{StaticResource Badge}" Background="{Binding Reputation, Converter={StaticResource HealthBrush}}" Padding="6,2">
                                    <TextBlock Text="{Binding ReputationLabel}" Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T Process_Signature}" Binding="{Binding Signed}" Width="1.5*" />
                    <DataGridTemplateColumn Header="{l:T Process_Actions}" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ProcessRow}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{l:T Process_Stop}" Appearance="Secondary" Margin="2" Padding="8,2"
                                               AutomationProperties.Name="{Binding Name}"
                                               Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" Visibility="{Binding CanStop, Converter={StaticResource Visible}}" />
                                    <ui:Button Content="{l:T Process_RemoveStartup}" Appearance="Secondary" Margin="2" Padding="8,2"
                                               Command="{Binding DataContext.RemoveFromStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" Visibility="{Binding CanRemoveFromStartup, Converter={StaticResource Visible}}" />
                                    <ui:Button Content="{l:T Process_DisableService}" Appearance="Secondary" Margin="2" Padding="8,2"
                                               Command="{Binding DataContext.DisableServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" Visibility="{Binding HasService, Converter={StaticResource Visible}}" />
                                    <ui:Button Content="{l:T Process_OpenLocation}" Appearance="Transparent" Margin="2" Padding="8,2"
                                               Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" Visibility="{Binding HasLocation, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="4" Text="{l:T Process_History}" Style="{StaticResource SectionTitle}" />
            <DataGrid Grid.Row="5" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      AutomationProperties.Name="{l:T Process_History}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T Process_Name}" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="{l:T Process_AvgCpu}" Binding="{Binding Cpu}" Width="*" />
                    <DataGridTextColumn Header="{l:T Process_AvgMemory}" Binding="{Binding Memory}" Width="*" />
                    <DataGridTextColumn Header="{l:T Process_Presence}" Binding="{Binding Presence}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <v:BusyOverlay />
    </Grid>
</UserControl>
