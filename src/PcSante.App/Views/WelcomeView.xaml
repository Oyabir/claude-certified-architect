<UserControl x:Class="PcSante.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:c="clr-namespace:PcSante.App.Controls">
    <!--
      Premier lancement (maquettes 07 à 09) : panneau de marque Nuit à gauche, contenu centré à droite, 3 étapes.
      Étape 1 : langue + mode Simple / Avancé · Étape 2 : licence (cahier des charges § 11) · Étape 3 : première analyse.
    -->
    <UserControl.Resources>
        <Style x:Key="StepSegment" TargetType="Border">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource PcsTrackBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PcsBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Panneau de marque -->
        <Border Style="{StaticResource PcsNightCard}" CornerRadius="{DynamicResource PcsRadiusPanel}" Margin="24" Padding="44,44">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Logo/app-icon-64.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PcsOnNightBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:T Welcome_Promise}" Style="{StaticResource PcsText.Display}" Foreground="{DynamicResource PcsOnNightBrush}"
                           Margin="0,64,0,0" />

                <!-- Bas du panneau : promesses (étapes 1 et 2) ou légende du score (étape 3) -->
                <StackPanel VerticalAlignment="Bottom" Visibility="{Binding StepThreeReached, Converter={StaticResource Collapsed}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <c:IconTile Icon="{StaticResource PcsIcon.check-circle}" Size="38" IconSize="20" CornerRadius="10" Tone="Brand" Opacity="0.9" />
                        <TextBlock Text="{l:T Welcome_Promise1}" Foreground="{DynamicResource PcsOnNightBrush}" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="360" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <c:IconTile Icon="{StaticResource PcsIcon.zap}" Size="38" IconSize="20" CornerRadius="10" Tone="Brand" Opacity="0.9" />
                        <TextBlock Text="{l:T Welcome_Promise2}" Foreground="{DynamicResource PcsOnNightBrush}" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="360" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:IconTile Icon="{StaticResource PcsIcon.shield}" Size="38" IconSize="20" CornerRadius="10" Tone="Brand" Opacity="0.9" />
                        <TextBlock Text="{l:T Welcome_Promise3}" Foreground="{DynamicResource PcsOnNightBrush}" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="360" />
                    </StackPanel>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" Visibility="{Binding StepThreeReached, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Source={l:T Welcome_ScoreLegend}, Converter={StaticResource Upper}}" Style="{StaticResource PcsText.Overline}"
                               Foreground="{DynamicResource PcsNightTextBrush}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <c:StatusChip Tone="Good" Text="{l:T Color_Green}" Margin="0,0,0,10" />
                        <TextBlock Grid.Column="1" Text="{Binding RangeGood}" Foreground="{DynamicResource PcsOnNightBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <c:StatusChip Grid.Row="1" Tone="Warn" Text="{l:T Color_Orange}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RangeWarn}" Foreground="{DynamicResource PcsOnNightBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <c:StatusChip Grid.Row="2" Tone="Critical" Text="{l:T Color_Red}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RangeCritical}" Foreground="{DynamicResource PcsOnNightBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenu -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel MaxWidth="600" Margin="40,32" VerticalAlignment="Center">
                <!-- Indicateur d'étape -->
                <TextBlock Text="{Binding StepText}" Style="{StaticResource PcsText.Muted}" FontWeight="SemiBold" />
                <Grid Margin="0,10,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StepSegment}" Background="{DynamicResource PcsBrandBrush}" />
                    <Border Grid.Column="2">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepSegment}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepTwoReached}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PcsBrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Grid.Column="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepSegment}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepThreeReached}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PcsBrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <!-- Message de résultat -->
                <Border CornerRadius="14" Padding="16,12" Margin="0,0,0,20" AutomationProperties.LiveSetting="Assertive"
                        Background="{Binding Message.Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Soft}"
                        Visibility="{Binding Message.IsOpen, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <c:LineIcon DockPanel.Dock="Left" Size="20" Margin="0,0,12,0" StrokeThickness="2.2"
                                    Data="{Binding Message.Tone, Converter={StaticResource ToneIcon}}"
                                    Foreground="{Binding Message.Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Text}" />
                        <TextBlock Text="{Binding Message.Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- ===== Étape 1 : langue et mode ===== -->
                <StackPanel Visibility="{Binding IsLanguageStep, Converter={StaticResource Visible}}">
                    <TextBlock Text="{l:T Welcome_LanguageTitle}" Style="{StaticResource PcsText.PageTitle}" />
                    <TextBlock Text="{l:T Welcome_LanguageHelp}" Style="{StaticResource PcsText.Muted}" Margin="0,6,0,18" />
                    <UniformGrid Columns="3" AutomationProperties.Name="{l:T Welcome_Language}">
                        <RadioButton Style="{StaticResource PcsChoiceTile}" GroupName="lang" Margin="0,0,8,0" AutomationProperties.Name="Français"
                                     IsChecked="{Binding Language, Converter={StaticResource EqualsParam}, ConverterParameter=fr}">
                            <StackPanel>
                                <c:TagLabel Text="FR" Tone="Brand" />
                                <TextBlock Text="Français" FontSize="18" FontWeight="Bold" Margin="0,10,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource PcsChoiceTile}" GroupName="lang" Margin="4,0" AutomationProperties.Name="English"
                                     IsChecked="{Binding Language, Converter={StaticResource EqualsParam}, ConverterParameter=en}">
                            <StackPanel>
                                <c:TagLabel Text="EN" Tone="Brand" />
                                <TextBlock Text="English" FontSize="18" FontWeight="Bold" Margin="0,10,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource PcsChoiceTile}" GroupName="lang" Margin="8,0,0,0" AutomationProperties.Name="العربية"
                                     IsChecked="{Binding Language, Converter={StaticResource EqualsParam}, ConverterParameter=ar}">
                            <StackPanel>
                                <c:TagLabel Text="AR" Tone="Brand" />
                                <TextBlock Text="العربية" FontSize="18" FontWeight="Bold" Margin="0,10,0,0" FontFamily="{StaticResource PcsFontArabic}" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <TextBlock Text="{l:T Welcome_ModeTitle}" Style="{StaticResource PcsText.SectionTitle}" Margin="0,28,0,12" />
                    <UniformGrid Columns="2">
                        <RadioButton Style="{StaticResource PcsChoiceTile}" GroupName="mode" Margin="0,0,8,0" IsChecked="{Binding SimpleMode}">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="{l:T Welcome_ModeSimple}" FontSize="17" FontWeight="Bold" Margin="0,0,8,0" />
                                    <c:TagLabel Text="{l:T Tag_Advised}" Tone="Brand" />
                                </WrapPanel>
                                <TextBlock Text="{l:T Welcome_ModeSimpleScreens}" Style="{StaticResource PcsText.Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource PcsChoiceTile}" GroupName="mode" Margin="8,0,0,0" IsChecked="{Binding AdvancedMode}">
                            <StackPanel>
                                <TextBlock Text="{l:T Welcome_ModeAdvanced}" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{l:T Welcome_ModeAdvancedScreens}" Style="{StaticResource PcsText.Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <TextBlock Text="{l:T Welcome_ModeHelp}" Style="{StaticResource PcsText.Muted}" Margin="0,10,0,0" />

                    <Button Style="{StaticResource PcsButton.Primary.Large}" HorizontalAlignment="Right" Margin="0,24,0,0" Padding="28,0"
                            Content="{l:T Common_Continue}" Command="{Binding ChooseLanguageCommand}" />
                </StackPanel>

                <!-- ===== Étape 2 : licence ===== -->
                <StackPanel Visibility="{Binding IsLicenseStep, Converter={StaticResource Visible}}">
                    <TextBlock Text="{l:T Welcome_License}" Style="{StaticResource PcsText.PageTitle}" />
                    <TextBlock Text="{l:T Welcome_LicenseHelp}" Style="{StaticResource PcsText.Muted}" Margin="0,6,0,18" />
                    <TextBox Style="{StaticResource PcsInput}" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Tag="PCS-XXXXX-XXXXX-XXXXX-XXXXX"
                             FontFamily="Consolas" FlowDirection="LeftToRight" AutomationProperties.Name="{l:T License_EnterKey}" />
                    <DockPanel Margin="0,24,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PcsButton.Primary.Large}" Padding="28,0" c:Ui.Icon="{StaticResource PcsIcon.key}"
                                Content="{l:T License_Activate}" Command="{Binding ActivateCommand}" IsEnabled="{Binding KeyLooksValid}"
                                c:Ui.IsLoading="{Binding IsBusy}" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource PcsButton.Ghost}" Content="{l:T Welcome_Back}" Command="{Binding BackCommand}" />
                        <Button Style="{StaticResource PcsButton.Secondary}" Content="{l:T Welcome_SkipLicense}" Command="{Binding SkipLicenseCommand}"
                                HorizontalAlignment="Right" Margin="0,0,10,0" />
                    </DockPanel>
                </StackPanel>

                <!-- ===== Étape 3 : première analyse ===== -->
                <StackPanel Visibility="{Binding IsAnalysisStep, Converter={StaticResource Visible}}">
                    <TextBlock Text="{l:T Welcome_AnalysisDone}" Style="{StaticResource PcsText.PageTitle}" />

                    <Border Style="{StaticResource PcsCard}" Padding="28,24" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:ScoreRing Width="128" Height="128" Thickness="12" ValueFontSize="40" Value="{Binding ScoreValue}" IsIndeterminate="{Binding IsBusy}"
                                         Caption="{l:T Home_OutOf100}" AutomationProperties.Name="{Binding ScoreLabel}" />
                            <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T Home_Analyzing}" Style="{StaticResource PcsText.CardTitle}"
                                           Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                                <StackPanel Visibility="{Binding Report, Converter={StaticResource Visible}}">
                                    <c:StatusChip Tone="{Binding ScoreTone}" Text="{Binding ScoreLabel}" />
                                    <TextBlock Text="{Binding Conclusion}" Style="{StaticResource PcsText.CardTitle}" FontSize="18" Margin="0,10,0,0" />
                                </StackPanel>
                                <!-- Échec (service absent ou en démarrage) : jamais d'impasse. -->
                                <StackPanel Visibility="{Binding AnalysisFailed, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{l:T Welcome_AnalysisFailed}" Style="{StaticResource PcsText.Caption}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource PcsButton.Primary}" Content="{l:T Common_Retry}" Command="{Binding RetryAnalysisCommand}" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource PcsButton.Secondary}" Content="{l:T Welcome_ContinueLater}" Command="{Binding FinishCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Veille automatique : interrupteur désactivé par défaut (Premium) -->
                    <Border Style="{StaticResource PcsCard}" Padding="26,20" Margin="0,16,0,0" Visibility="{Binding CanEnableTasks, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PcsSwitch}" IsChecked="{Binding WatchRequested}"
                                          AutomationProperties.Name="{l:T Welcome_WatchTitle}" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <c:IconTile DockPanel.Dock="Left" Icon="{StaticResource PcsIcon.clock}" Size="44" IconSize="22" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T Welcome_WatchTitle}" Style="{StaticResource PcsText.RowTitle}" />
                                <TextBlock Text="{l:T Welcome_TasksHelp}" Style="{StaticResource PcsText.Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel Margin="0,24,0,0" Visibility="{Binding Report, Converter={StaticResource Visible}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PcsButton.Primary.Large}" Padding="28,0" Content="{l:T Welcome_Finish}"
                                Command="{Binding FinishCommand}" c:Ui.IsLoading="{Binding IsBusy}" />
                        <Button Style="{StaticResource PcsButton.Ghost}" Content="{l:T Welcome_Back}" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
