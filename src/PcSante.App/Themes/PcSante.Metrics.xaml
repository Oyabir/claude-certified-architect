    <sys:Double x:Key="PcsSpacePageBottom">32</sys:Double>
    <!-- Polices : copier assets/fonts dans le projet (Build Action = Content / Resource).
         WPF   : FontFamily="pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans"
         WinUI : FontFamily="ms-appx:///Assets/Fonts/PlusJakartaSans_400Regular.ttf#Plus Jakarta Sans" -->
    <FontFamily x:Key="PcsFontLatin">/Assets/Fonts/#Plus Jakarta Sans, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="PcsFontArabic">/Assets/Fonts/#IBM Plex Sans Arabic, Segoe UI</FontFamily>
    <sys:Double x:Key="PcsFontSizeScore">52</sys:Double>
    <sys:Double x:Key="PcsFontSizeDisplay">40</sys:Double>
    <sys:Double x:Key="PcsFontSizePageTitle">28</sys:Double>
