<UserControl x:Class="PcSante.App.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:vm="clr-namespace:PcSante.App.ViewModels"
             xmlns:v="clr-namespace:PcSante.App.Views">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="4,0,12,24">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

                <!-- Nettoyage -->
                <ui:Card Padding="20">
                    <StackPanel>
                        <TextBlock Text="{l:T Cleanup_Title}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalCleanable}" Margin="0,4,0,12" />
                        <ItemsControl ItemsSource="{Binding Cleanup}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CleanupChoice}">
                                    <CheckBox IsChecked="{Binding Selected}" Margin="0,4" AutomationProperties.Name="{Binding Label}">
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /> — <Run Text="{Binding Size, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Technical}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T Cleanup_Warning}" Style="{StaticResource Technical}" Margin="0,8,0,12" />
                        <ui:Button Style="{StaticResource PrimaryAction}" HorizontalAlignment="Left" Content="{l:T Cleanup_Button}"
                                   Icon="{ui:SymbolIcon Broom24}" Command="{Binding CleanCommand}" />
                    </StackPanel>
                </ui:Card>

                <!-- Programmes au démarrage -->
                <TextBlock Text="{l:T Startup_Title}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{l:T Startup_Explanation}" Style="{StaticResource Technical}" Margin="0,-6,0,8" />
                <TextBlock Text="{l:T Startup_None}" Visibility="{Binding Startup.Count, Converter={StaticResource Collapsed}}" />
                <ItemsControl ItemsSource="{Binding Startup}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StartupRow}">
                            <ui:Card Margin="0,0,0,6" Padding="16,8">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource SecondaryAction}" Content="{Binding ActionLabel}"
                                               AutomationProperties.Name="{Binding Name}"
                                               Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Technical}">
                                            <Run Text="{Binding State, Mode=OneWay}" /> · <Run Text="{Binding Location, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Mode Avancé : tâches planifiées tierces et alimentation -->
                <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource Visible}}">
                    <TextBlock Text="{l:T Tasks_Title}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T Tasks_Explanation}" Style="{StaticResource Technical}" Margin="0,-6,0,8" />
                    <ItemsControl ItemsSource="{Binding Tasks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TaskRow}">
                                <ui:Card Margin="0,0,0,6" Padding="16,8">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource SecondaryAction}" Content="{Binding ActionLabel}"
                                                   AutomationProperties.Name="{Binding Name}"
                                                   Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Technical}" />
                                        </StackPanel>
                                    </DockPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{l:T Power_Title}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T Power_Explanation}" Style="{StaticResource Technical}" Margin="0,-6,0,8" />
                    <ItemsControl ItemsSource="{Binding PowerPlans}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PowerRow}">
                                <ui:Card Margin="0,0,0,6" Padding="16,8">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource SecondaryAction}" Content="{l:T Power_Use}"
                                                   AutomationProperties.Name="{Binding Name}"
                                                   Command="{Binding DataContext.SetPowerPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource Collapsed}}" />
                                        <TextBlock Text="{l:T Power_Active}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Visibility="{Binding IsActive, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Annuler une optimisation -->
                <TextBlock Text="{l:T Undo_Title}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{l:T Undo_None}" Visibility="{Binding Undoable.Count, Converter={StaticResource Collapsed}}" />
                <ItemsControl ItemsSource="{Binding Undoable}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UndoRow}">
                            <ui:Card Margin="0,0,0,6" Padding="16,8">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource SecondaryAction}" Content="{l:T Undo_Button}"
                                               AutomationProperties.Name="{Binding Label}"
                                               Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="{Binding Date}" Style="{StaticResource Technical}" />
                                    </StackPanel>
                                </DockPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <v:BusyOverlay />
    </Grid>
</UserControl>
