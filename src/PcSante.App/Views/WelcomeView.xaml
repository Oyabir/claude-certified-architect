<UserControl x:Class="PcSante.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="40,24" MaxWidth="720" HorizontalAlignment="Center">
                <TextBlock Text="{l:T Welcome_Title}" Style="{StaticResource PageTitle}" FontSize="32" />
                <TextBlock Text="{l:T Welcome_Promise}" Style="{StaticResource PageSubtitle}" FontSize="17" />
                <TextBlock Text="{Binding StepText}" Style="{StaticResource Technical}" Margin="0,0,0,12" />

                <ui:InfoBar IsOpen="{Binding Message.IsOpen, Mode=TwoWay}" Severity="{Binding Message.Severity}" Title="{Binding Message.Text}"
                            IsClosable="True" Margin="0,0,0,12" />

                <!-- Étape 1 : langue -->
                <ui:Card Padding="24" Visibility="{Binding IsLanguageStep, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{l:T Welcome_Language}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Language}"
                                  FontSize="16" AutomationProperties.Name="{l:T Welcome_Language}" />
                        <ui:Button Style="{StaticResource PrimaryAction}" Content="{l:T Common_Continue}" Command="{Binding ChooseLanguageCommand}"
                                   HorizontalAlignment="Left" Margin="0,20,0,0" />
                    </StackPanel>
                </ui:Card>

                <!-- Étape 2 : licence -->
                <ui:Card Padding="24" Visibility="{Binding IsLicenseStep, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{l:T Welcome_License}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{l:T Welcome_LicenseHelp}" Margin="0,4,0,12" />
                        <ui:TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="PCS-XXXXX-XXXXX-XXXXX-XXXXX"
                                    FontSize="18" FontFamily="Consolas" FlowDirection="LeftToRight" AutomationProperties.Name="{l:T License_EnterKey}" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <ui:Button Style="{StaticResource PrimaryAction}" Content="{l:T License_Activate}" Command="{Binding ActivateCommand}"
                                       IsEnabled="{Binding KeyLooksValid}" />
                            <ui:Button Style="{StaticResource SecondaryAction}" Content="{l:T Welcome_SkipLicense}" Command="{Binding SkipLicenseCommand}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Étape 3 : première analyse (automatique), puis tâches recommandées -->
                <ui:Card Padding="24" Visibility="{Binding IsAnalysisStep, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{l:T Welcome_Analysis}" FontSize="19" FontWeight="SemiBold" />
                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,16">
                            <ui:ProgressRing IsIndeterminate="True" />
                            <TextBlock Text="{l:T Home_Analyzing}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding Report, Converter={StaticResource Visible}}" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="110" Height="110" CornerRadius="55" Background="{Binding Report.Color, Converter={StaticResource HealthBrush}}">
                                    <TextBlock Text="{Binding Report.Score}" FontSize="44" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{l:T Welcome_ScoreHelp}" VerticalAlignment="Center" Margin="20,0,0,0" MaxWidth="440" FontSize="16" />
                            </StackPanel>
                            <ui:Card Padding="16" Margin="0,16,0,0" Visibility="{Binding CanEnableTasks, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="{l:T Welcome_Tasks}" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:T Welcome_TasksHelp}" Margin="0,4,0,8" />
                                    <ui:Button Style="{StaticResource SecondaryAction}" Content="{l:T Scheduling_EnableAll}" Command="{Binding EnableTasksCommand}"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Button Style="{StaticResource PrimaryAction}" Content="{l:T Welcome_Finish}" Command="{Binding FinishCommand}"
                                       HorizontalAlignment="Left" Margin="0,20,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
