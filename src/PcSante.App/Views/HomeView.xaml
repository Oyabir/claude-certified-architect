<UserControl x:Class="PcSante.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:vm="clr-namespace:PcSante.App.ViewModels"
             xmlns:v="clr-namespace:PcSante.App.Views"
             xmlns:c="clr-namespace:PcSante.App.Controls">
    <!-- Accueil (maquette 01-accueil.png) : une question, « comment va mon PC ? », sans défilement à 1440 × 940. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Margin="40,28,40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:T Home_Greeting}" Style="{StaticResource PcsText.PageTitle}" />
                        <TextBlock Text="{Binding HeaderLine}" Style="{StaticResource PcsText.Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PcsButton.Secondary}" c:Ui.Icon="{StaticResource PcsIcon.refresh}"
                            Content="{l:T Home_Rescan}" Command="{Binding AnalyzeCommand}" VerticalAlignment="Center"
                            Visibility="{Binding HasReport, Converter={StaticResource Visible}}" />
                </Grid>

                <!-- Carte score : anneau · conclusion et actions · sous-scores -->
                <Border Grid.Row="1" Style="{StaticResource PcsCard}" Padding="32,26" Margin="0,24,0,0">
                    <Grid x:Name="ScoreGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SubScoreColumn" Width="440" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <c:ScoreRing Value="{Binding ScoreValue}" IsIndeterminate="{Binding IsBusy}" Caption="{l:T Home_OutOf100}" VerticalAlignment="Center"
                                     AutomationProperties.Name="{Binding ScoreLabel}" AutomationProperties.HelpText="{Binding Score}" />

                        <StackPanel Grid.Column="1" Margin="40,0" VerticalAlignment="Center">
                            <c:StatusChip Tone="{Binding ScoreTone}" Text="{Binding ScoreLabel}"
                                          Visibility="{Binding HasReport, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding Conclusion}" Style="{StaticResource PcsText.HeroTitle}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource PcsText.Caption}" Margin="0,10,0,0"
                                       Visibility="{Binding HasIssues, Converter={StaticResource Visible}}" />
                            <WrapPanel Margin="0,20,0,0">
                                <!-- Un seul bouton principal : « Tout corriger » (Premium), sinon « Analyser mon PC » si aucune analyse. -->
                                <Button Style="{StaticResource PcsButton.Primary}" c:Ui.Icon="{StaticResource PcsIcon.check}" Content="{l:T Home_FixAll}"
                                        Command="{Binding FixAllCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding PrimaryIsFixAll, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource PcsButton.Secondary}" Content="{Binding FixAllPremiumLabel}" Command="{Binding FixAllCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding ShowFixAllPremium, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource PcsButton.Primary}" c:Ui.Icon="{StaticResource PcsIcon.search}" Content="{l:T Home_Analyze}"
                                        Command="{Binding AnalyzeCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding HasReport, Converter={StaticResource Collapsed}}" />
                                <Button Style="{StaticResource PcsButton.Ghost}" Content="{l:T Home_Details}" Click="OnShowDetails"
                                        Visibility="{Binding HasIssues, Converter={StaticResource Visible}}" />
                            </WrapPanel>
                        </StackPanel>

                        <ItemsControl x:Name="SubScoreList" Grid.Column="2" ItemsSource="{Binding SubScores}" VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SubScoreItem}">
                                    <c:SubScoreTile Label="{Binding Label}" Value="{Binding Value}" Icon="{Binding Icon, Converter={StaticResource ResourceKey}}"
                                                    Margin="6" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Rangée basse : ce qu'il faut regarder · veille automatique et activité récente -->
                <Grid x:Name="BottomGrid" Grid.Row="2" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SideColumn" Width="380" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="IssuesCard" Style="{StaticResource PcsCard}" Padding="28,24" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding IssuesCount}" Style="{StaticResource PcsText.Muted}" VerticalAlignment="Center" />
                                <TextBlock Text="{l:T Home_Issues}" Style="{StaticResource PcsText.SectionTitle}" />
                            </DockPanel>

                            <c:EmptyState Icon="{StaticResource PcsIcon.check}" Text="{l:T Home_NoIssues}">
                                <c:EmptyState.Visibility>
                                    <MultiBinding Converter="{StaticResource AllTrue}">
                                        <Binding Path="HasReport" />
                                        <Binding Path="HasIssues" Converter="{StaticResource Not}" />
                                    </MultiBinding>
                                </c:EmptyState.Visibility>
                            </c:EmptyState>

                            <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:IssueItem}">
                                        <c:ListRow Title="{Binding Title}" Description="{Binding Why}" TagText="{Binding Tag}" TagTone="{Binding Tone}"
                                                   Tone="{Binding Tone}" Icon="{Binding Icon, Converter={StaticResource ResourceKey}}">
                                            <Button Style="{StaticResource PcsButton.Secondary}" Content="{Binding FixLabel}"
                                                    AutomationProperties.HelpText="{Binding Title}"
                                                    Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanFix, Converter={StaticResource Visible}}" />
                                        </c:ListRow>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,18,0,0" Visibility="{Binding HasAllGood, Converter={StaticResource Visible}}">
                                <TextBlock Text="{l:T Home_AllGoodTitle}" Style="{StaticResource PcsText.Muted}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding AllGood}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,10">
                                                <c:IconTile Tone="Good" Icon="{StaticResource PcsIcon.check}" Size="26" IconSize="14" CornerRadius="13" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource PcsTextStrongBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SidePanel" Grid.Column="1" Margin="24,0,0,0">
                        <!-- Veille automatique (carte de marque Nuit) -->
                        <Border Style="{StaticResource PcsNightCard}" Padding="28,24">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding WatchStatus}" FontWeight="Bold" Foreground="{DynamicResource PcsNightAccentBrush}" VerticalAlignment="Center" />
                                    <c:LineIcon DockPanel.Dock="Left" Data="{StaticResource PcsIcon.clock}" Size="22" Foreground="{DynamicResource PcsNightAccentBrush}" Margin="0,0,10,0" />
                                    <TextBlock Text="{l:T Watch_Title}" Style="{StaticResource PcsText.SectionTitle}" Foreground="{DynamicResource PcsOnNightBrush}" />
                                </DockPanel>
                                <TextBlock Text="{l:T Watch_Text}" Foreground="{DynamicResource PcsNightTextBrush}" Margin="0,12,0,0"
                                           Visibility="{Binding WatchActive, Converter={StaticResource Collapsed}}" />
                                <TextBlock Text="{l:T Watch_ActiveText}" Foreground="{DynamicResource PcsNightTextBrush}" Margin="0,12,0,0"
                                           Visibility="{Binding WatchActive, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource PcsButton.Night}" Content="{l:T Watch_Enable3}" Command="{Binding EnableWatchCommand}"
                                        HorizontalAlignment="Left" Margin="0,18,0,0"
                                        Visibility="{Binding WatchActive, Converter={StaticResource Collapsed}}" />
                            </StackPanel>
                        </Border>

                        <!-- Activité récente : 3 dernières actions du journal -->
                        <Border Style="{StaticResource PcsCard}" Padding="28,22" Margin="0,20,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PcsButton.Ghost}" Content="{l:T Activity_All}" Command="{Binding ShowActivityCommand}"
                                            MinHeight="32" Padding="8,0" />
                                    <TextBlock Text="{l:T Activity_Title}" Style="{StaticResource PcsText.CardTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{l:T Activity_Empty}" Style="{StaticResource PcsText.Muted}"
                                           Visibility="{Binding HasActivity, Converter={StaticResource Collapsed}}" />
                                <ItemsControl ItemsSource="{Binding Activity}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ActivityItem}">
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,7,12,0"
                                                         Fill="{Binding Succeeded, Converter={StaticResource ToneBrush}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding When}" Style="{StaticResource PcsText.Muted}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
        <v:BusyOverlay />
    </Grid>
</UserControl>
