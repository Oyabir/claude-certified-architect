<UserControl x:Class="PcSante.App.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:vm="clr-namespace:PcSante.App.ViewModels"
             xmlns:v="clr-namespace:PcSante.App.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="ActionRow" DataType="{x:Type vm:SystemActionItem}">
            <ui:Card Margin="0,0,0,6" Padding="16,10">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource SecondaryAction}" Content="{Binding Label}"
                               Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Explanation}" />
                        <TextBlock Text="{Binding Duration}" Style="{StaticResource Technical}" />
                    </StackPanel>
                </DockPanel>
            </ui:Card>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="40,28,40,32">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource Technical}" Margin="0,0,0,12" />

                <TextBlock Text="{l:T System_Updates}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{l:T System_UpdatesTech}" Style="{StaticResource Technical}" Margin="0,-6,0,4" />
                <TextBlock Text="{Binding UpdateSummary}" Margin="0,0,0,12" />
                <ui:Button Style="{StaticResource PrimaryAction}" HorizontalAlignment="Left" Content="{l:T Command_SearchUpdates}"
                           Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding SearchUpdatesCommand}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding UpdateActions}" ItemTemplate="{StaticResource ActionRow}" Focusable="False" />

                <TextBlock Text="{l:T System_Repair}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{l:T System_RepairTech}" Style="{StaticResource Technical}" Margin="0,-6,0,8" />
                <ItemsControl ItemsSource="{Binding RepairActions}" ItemTemplate="{StaticResource ActionRow}" Focusable="False" />

                <TextBlock Text="{l:T System_Restore}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{l:T System_RestoreTech}" Style="{StaticResource Technical}" Margin="0,-6,0,8" />
                <ItemsControl ItemsSource="{Binding RestoreActions}" ItemTemplate="{StaticResource ActionRow}" Focusable="False" />

                <TextBlock Text="{l:T Protection_Firewall}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{l:T Protection_FirewallTech}" Style="{StaticResource Technical}" Margin="0,-6,0,8" />
                <ItemsControl ItemsSource="{Binding FirewallActions}" ItemTemplate="{StaticResource ActionRow}" Focusable="False" />

                <TextBlock Text="{l:T System_Network}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{l:T System_NetworkTech}" Style="{StaticResource Technical}" Margin="0,-6,0,8" />
                <ItemsControl ItemsSource="{Binding NetworkActions}" ItemTemplate="{StaticResource ActionRow}" Focusable="False" />

                <StackPanel Visibility="{Binding ShowBitLocker, Converter={StaticResource Visible}}">
                    <TextBlock Text="{l:T System_BitLocker}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T System_BitLockerTech}" Style="{StaticResource Technical}" Margin="0,-6,0,8" />
                    <ui:Card Padding="16,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding BitLockerSummary}" TextWrapping="Wrap" />
                            <TextBlock Text="{l:T BitLocker_Explanation}" Style="{StaticResource Technical}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <WrapPanel>
                                <ui:Button Style="{StaticResource SecondaryAction}" Content="{l:T BitLocker_Enable}" Command="{Binding EnableBitLockerCommand}"
                                           Margin="0,0,8,0" Visibility="{Binding CanEnableBitLocker, Converter={StaticResource Visible}}" />
                                <ui:Button Style="{StaticResource SecondaryAction}" Content="{l:T BitLocker_SaveKey}" Command="{Binding SaveRecoveryKeyCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <TextBlock Text="{l:T System_Accounts}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{l:T System_AccountsTech}" Style="{StaticResource Technical}" Margin="0,-6,0,8" />
                <TextBlock Text="{Binding AccountsSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AccountRow}">
                            <ui:Card Margin="0,0,0,6" Padding="16,10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding State}" VerticalAlignment="Center" Style="{StaticResource Technical}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Role}" Style="{StaticResource Technical}" />
                                    </StackPanel>
                                </DockPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding AccountActions}" ItemTemplate="{StaticResource ActionRow}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>
        <v:BusyOverlay />
    </Grid>
</UserControl>
