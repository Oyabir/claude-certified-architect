{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Directory": "logs"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Console": "Data Source=pmeconsole.db"
  },
  "RateLimiting": {
    "DevicesPerMinute": 30,
    "ManagersPerMinute": 120
  },
  "Email": {
    "From": "",
    "SmtpHost": "",
    "SmtpPort": 587,
    "UserName": "",
    "PickupDirectory": "mails"
  },
  "AllowedHosts": "*"
}
