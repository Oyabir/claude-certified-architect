<Application x:Class="PcSante.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:infra="clr-namespace:PcSante.App.Infrastructure"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- Jetons de la refonte (docs/redesign/tokens) : couleurs remplacées au démarrage selon le thème (App.ApplyTheme). -->
                <ResourceDictionary Source="Themes/PcSante.Metrics.xaml" />
                <ResourceDictionary Source="Themes/PcSante.Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/PcSante.Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Polices embarquées (Assets/Fonts, licence OFL). -->
            <FontFamily x:Key="PcsFontLatin">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans, Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="PcsFontArabic">pack://application:,,,/Assets/Fonts/#IBM Plex Sans Arabic, Segoe UI</FontFamily>

            <!--
              Cahier des charges § 11 : aucun texte sous 14 px. Les tailles 11 à 13 des maquettes sont relevées à 14 ;
              la hiérarchie passe par la graisse et la couleur (voir DECISIONS.md).
            -->
            <sys:Double x:Key="PcsFontSizeCaption">14</sys:Double>
            <sys:Double x:Key="PcsFontSizeSmall">14</sys:Double>
            <sys:Double x:Key="PcsFontSizeOverline">14</sys:Double>

            <infra:HealthBrushConverter x:Key="HealthBrush" />
            <infra:BoolToVisibilityConverter x:Key="Visible" />
            <infra:BoolToVisibilityConverter x:Key="Collapsed" Invert="True" />

            <!-- Accessibilité : texte d'au moins 14 px partout (section 11). -->
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Anciennes clés, alignées sur les composants de la refonte. -->
            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource PcsText.PageTitle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource PcsText.Muted}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PcsText.SectionTitle}">
                <Setter Property="Margin" Value="0,20,0,10" />
            </Style>

            <!-- Terme technique affiché en petit sous le libellé simple. -->
            <Style x:Key="Technical" TargetType="TextBlock" BasedOn="{StaticResource PcsText.Muted}" />

            <!-- Un seul bouton principal par écran. -->
            <Style x:Key="PrimaryAction" TargetType="ButtonBase" BasedOn="{StaticResource PcsButton.Primary}">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="SecondaryAction" TargetType="ButtonBase" BasedOn="{StaticResource PcsButton.Secondary}">
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
