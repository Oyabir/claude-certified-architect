<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>PcSante</AssemblyName>
    <!-- Description du fichier : nom lisible dans le Gestionnaire des tâches et la liste de démarrage. -->
    <AssemblyTitle>$(PcSanteProductName)</AssemblyTitle>
    <RootNamespace>PcSante.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\pcsante.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PcSante.Core/PcSante.Core.csproj" />
    <ProjectReference Include="../PcSante.Ipc/PcSante.Ipc.csproj" />
    <ProjectReference Include="../PcSante.Reporting/PcSante.Reporting.csproj" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <!-- Galerie des composants : outil de développement, absent de la version livrée. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Page Remove="Views\GalleryWindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\pcsante.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Logo\*.png" />
    <None Include="Assets\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
