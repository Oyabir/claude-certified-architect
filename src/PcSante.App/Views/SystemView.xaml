<UserControl x:Class="PcSante.App.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:vm="clr-namespace:PcSante.App.ViewModels"
             xmlns:v="clr-namespace:PcSante.App.Views"
             xmlns:c="clr-namespace:PcSante.App.Controls">
    <!-- Système (maquette 04-systeme.png) : bandeau Windows Update, grille d'outils, chiffrement et comptes à droite. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Margin="40,28,40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,24">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PcsText.PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PcsText.Muted}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <!-- Bandeau Windows Update : un seul bouton principal. -->
                    <Border Style="{StaticResource PcsCard}" Padding="26,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:IconTile Icon="{StaticResource PcsIcon.download}" Tone="{Binding UpdateTone}" Size="56" IconSize="26" CornerRadius="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                                <WrapPanel>
                                    <TextBlock Text="{Binding UpdateTitle}" Style="{StaticResource PcsText.SectionTitle}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding WindowsEdition}" Style="{StaticResource PcsText.Muted}" VerticalAlignment="Center" />
                                </WrapPanel>
                                <TextBlock Text="{Binding UpdateSummary}" Style="{StaticResource PcsText.Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PcsButton.Primary}" c:Ui.Icon="{StaticResource PcsIcon.search}"
                                    Content="{l:T Command_SearchUpdates}" Command="{Binding SearchUpdatesCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Outils de réparation -->
                    <DockPanel Margin="0,20,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{l:T System_ToolsHint}" Style="{StaticResource PcsText.Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T System_Tools}" Style="{StaticResource PcsText.SectionTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Tools}" Focusable="False" Margin="-6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid x:Name="ToolGrid" Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SystemActionItem}">
                                <Border Style="{StaticResource PcsCard.Small}" Margin="6" Padding="16,12" ToolTip="{Binding FullText}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PcsButton.Secondary.Small}" Content="{Binding Verb}"
                                                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Duration}"
                                                    Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <c:LineIcon DockPanel.Dock="Left" Data="{StaticResource PcsIcon.clock}" Size="14" Foreground="{DynamicResource PcsTextMutedBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding ShortDuration}" Style="{StaticResource PcsText.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        </DockPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <c:IconTile Icon="{Binding Icon, Converter={StaticResource ResourceKey}}" Tone="Brand" Size="30" IconSize="16" CornerRadius="9" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource PcsText.Overline}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource PcsText.Strong}" />
                                            <TextBlock Text="{Binding ShortDescription}" Style="{StaticResource PcsText.Muted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Colonne droite : chiffrement du disque et comptes -->
                <StackPanel x:Name="SidePanel" Grid.Row="1" Grid.Column="1" Margin="24,0,0,0">
                    <Border Style="{StaticResource PcsCard}" Padding="24,20" Margin="0,0,0,20"
                            Visibility="{Binding ShowBitLocker, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <c:LineIcon Data="{StaticResource PcsIcon.lock}" Size="20" Foreground="{DynamicResource PcsBrandTextBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{l:T System_BitLocker}" Style="{StaticResource PcsText.CardTitle}" />
                            </StackPanel>
                            <c:StatusChip Tone="{Binding BitLockerTone}" Text="{Binding BitLockerChip}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding BitLockerSummary}" Style="{StaticResource PcsText.Caption}" Margin="0,10,0,0" />
                            <TextBlock Text="{l:T BitLocker_Explanation}" Style="{StaticResource PcsText.Muted}" Margin="0,6,0,12" />
                            <WrapPanel>
                                <Button Style="{StaticResource PcsButton.Secondary.Small}" Content="{l:T BitLocker_Enable}" Command="{Binding EnableBitLockerCommand}"
                                        Margin="0,0,8,8" Visibility="{Binding CanEnableBitLocker, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource PcsButton.Secondary.Small}" Content="{l:T BitLocker_SaveKeyShort}" Command="{Binding SaveRecoveryKeyCommand}" Margin="0,0,0,8"
                                        AutomationProperties.Name="{l:T BitLocker_SaveKey}" ToolTip="{l:T BitLocker_SaveKey}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PcsCard}" Padding="24,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <c:LineIcon Data="{StaticResource PcsIcon.users}" Size="20" Foreground="{DynamicResource PcsBrandTextBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{l:T System_Accounts}" Style="{StaticResource PcsText.CardTitle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding AdminCount}" Style="{StaticResource PcsText.Muted}" Margin="30,2,0,0" />
                            <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AccountRow}">
                                        <Border BorderBrush="{DynamicResource PcsDividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <DockPanel>
                                                <TextBlock x:Name="State" DockPanel.Dock="Right" Text="{Binding State}" Style="{StaticResource PcsStateText}"
                                                           Foreground="{DynamicResource PcsGoodTextBrush}" />
                                                <Border x:Name="Avatar" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource PcsIconTileBrush}" Margin="0,0,12,0">
                                                    <TextBlock x:Name="AvatarText" Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PcsTextSecondaryBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Text="{Binding Role}" Style="{StaticResource PcsText.Muted}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                <Setter TargetName="Avatar" Property="Background" Value="{DynamicResource PcsBrandBrush}" />
                                                <Setter TargetName="AvatarText" Property="Foreground" Value="{DynamicResource PcsOnBrandBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="State" Property="Foreground" Value="{DynamicResource PcsTextMutedBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding AccountsSummary}" Style="{StaticResource PcsText.Muted}" Margin="0,10,0,0"
                                       Visibility="{Binding ManyAdmins, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding AccountActions}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SystemActionItem}">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource PcsText.Muted}" Margin="0,0,0,8" />
                                            <Button Style="{StaticResource PcsButton.Secondary.Small}" Content="{Binding Label}" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <v:BusyOverlay />
    </Grid>
</UserControl>
