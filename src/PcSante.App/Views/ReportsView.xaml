<UserControl x:Class="PcSante.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:vm="clr-namespace:PcSante.App.ViewModels"
             xmlns:v="clr-namespace:PcSante.App.Views">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="40,28,40,32">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

                <ui:Card Padding="20">
                    <StackPanel>
                        <TextBlock Text="{l:T Reports_Evolution}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ScoreRange}" Style="{StaticResource Technical}" Margin="0,0,0,8" />
                        <Border Height="160" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="4" ClipToBounds="True">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="600" Height="100">
                                    <Line X1="0" X2="600" Y1="20" Y2="20" Stroke="#1E7B34" StrokeDashArray="4 4" Opacity="0.6" />
                                    <Line X1="0" X2="600" Y1="50" Y2="50" Stroke="#B42318" StrokeDashArray="4 4" Opacity="0.6" />
                                    <Polyline Points="{Binding ScorePoints}" Stroke="{DynamicResource PcsBrandBrush}" StrokeThickness="2" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="20" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T Reports_Pdf}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{l:T Reports_PdfExplanation}" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="{l:T Reports_Weekly}" GroupName="period" Margin="0,0,24,0" />
                            <RadioButton Content="{l:T Reports_Monthly}" GroupName="period" IsChecked="{Binding Monthly}" />
                        </StackPanel>
                        <ui:Button Style="{StaticResource PrimaryAction}" HorizontalAlignment="Left" Content="{l:T Reports_Generate}"
                                   Icon="{ui:SymbolIcon DocumentPdf24}" Command="{Binding GenerateCommand}" />
                        <ui:Button Style="{StaticResource SecondaryAction}" HorizontalAlignment="Left" Content="{l:T Reports_ExportCsv}"
                                   Icon="{ui:SymbolIcon Table24}" Command="{Binding ExportCsvCommand}" Margin="0,8,0,0" />
                        <!-- Rapports mensuels produits par la tâche planifiée « Rapport mensuel ». -->
                        <TextBlock Text="{l:T Reports_MonthlyAuto}" TextWrapping="Wrap" Margin="0,20,0,8" />
                        <ui:Button Style="{StaticResource SecondaryAction}" HorizontalAlignment="Left" Content="{l:T Reports_OpenFolder}"
                                   Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenReportsFolderCommand}" />
                    </StackPanel>
                </ui:Card>

                <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource Visible}}">
                    <TextBlock Text="{l:T Reports_Journal}" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding Journal}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="400"
                              AutomationProperties.Name="{l:T Reports_Journal}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Report_Date}" Binding="{Binding Date}" Width="150" />
                            <DataGridTextColumn Header="{l:T Reports_Who}" Binding="{Binding Who}" Width="150" />
                            <DataGridTextColumn Header="{l:T Report_Action}" Binding="{Binding Action}" Width="2*" />
                            <DataGridTextColumn Header="{l:T Report_Result}" Binding="{Binding Outcome}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <v:BusyOverlay />
    </Grid>
</UserControl>
