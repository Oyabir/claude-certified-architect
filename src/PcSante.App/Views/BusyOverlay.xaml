<UserControl x:Class="PcSante.App.Views.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
    <!-- Indicateur d'activité : l'utilisateur voit que l'action est en cours. -->
    <Border Background="#80000000" CornerRadius="8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:ProgressRing IsIndeterminate="True" Width="56" Height="56" />
            <TextBlock Text="{Binding BusyText}" Foreground="White" FontSize="16" Margin="0,16,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Border>
</UserControl>
