<UserControl x:Class="PcSante.App.Views.SchedulingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:vm="clr-namespace:PcSante.App.ViewModels"
             xmlns:v="clr-namespace:PcSante.App.Views"
             xmlns:c="clr-namespace:PcSante.App.Controls">
    <!-- Planification (§ 6.7) : une carte par tâche avec interrupteur Active / Inactive, jour et heure en ligne. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="40,28,40,32">
                <DockPanel Margin="0,0,0,24">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PcsButton.Primary}" c:Ui.Icon="{StaticResource PcsIcon.check}"
                            Content="{l:T Scheduling_EnableAll}" Command="{Binding EnableRecommendedCommand}" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PcsText.PageTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PcsText.Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Templates}" Focusable="False" Margin="-7,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TemplateRow}">
                            <Border Style="{StaticResource PcsCard}" Padding="24,20" Margin="7">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding State}" Margin="0,0,10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PcsStateText}">
                                                        <Setter Property="Foreground" Value="{DynamicResource PcsTextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PcsGoodTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Style="{StaticResource PcsSwitchButton}" c:Ui.IsOn="{Binding Enabled}" AutomationProperties.Name="{Binding SwitchName}"
                                                    Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource PcsText.CardTitle}" />
                                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource PcsText.Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PcsButton.Secondary.Small}" Content="{l:T Scheduling_Save}"
                                                AutomationProperties.HelpText="{Binding Label}"
                                                Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Visibility="{Binding Enabled, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding LastRun}" Style="{StaticResource PcsText.Muted}" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <WrapPanel Margin="0,14,0,0">
                                        <ComboBox MinWidth="150" Margin="0,0,10,8" SelectedValue="{Binding Day}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding DataContext.Days, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  AutomationProperties.Name="{l:T Scheduling_Day}" ToolTip="{l:T Scheduling_Day}"
                                                  Visibility="{Binding IsWeekly, Converter={StaticResource Visible}}" />
                                        <ComboBox MinWidth="100" Margin="0,0,16,8" SelectedItem="{Binding Time}"
                                                  ItemsSource="{Binding DataContext.Times, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  AutomationProperties.Name="{l:T Scheduling_Time}" ToolTip="{l:T Scheduling_Time}" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,0,8">
                                            <CheckBox Content="{l:T Scheduling_OnlyIdle}" IsChecked="{Binding OnlyWhenIdle}" />
                                            <CheckBox Content="{l:T Scheduling_OnlyAc}" IsChecked="{Binding OnlyOnAcPower}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource PcsCard}" Padding="24,20" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T Scheduling_Log}" Style="{StaticResource PcsText.CardTitle}" />
                        <TextBlock Text="{l:T Scheduling_LogEmpty}" Style="{StaticResource PcsText.Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding RunLog.Count, Converter={StaticResource Collapsed}}" />
                        <ItemsControl ItemsSource="{Binding RunLog}" Focusable="False" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource PcsDividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <TextBlock Text="{Binding}" Style="{StaticResource PcsText.Caption}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <v:BusyOverlay />
    </Grid>
</UserControl>
