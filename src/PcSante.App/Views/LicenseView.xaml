<UserControl x:Class="PcSante.App.Views.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:v="clr-namespace:PcSante.App.Views"
             xmlns:c="clr-namespace:PcSante.App.Controls">
    <!-- Licence (§ 6.7) : carte d'offre, clé de licence, carte « Ce PC ». -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="40,28,40,32" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PcsText.PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PcsText.Muted}" Margin="0,4,0,24" />

                <!-- Offre -->
                <Border Style="{StaticResource PcsCard}" Padding="26,22">
                    <DockPanel>
                        <c:IconTile DockPanel.Dock="Left" Icon="{StaticResource PcsIcon.shield-check}" Size="56" IconSize="28" CornerRadius="14" VerticalAlignment="Top" Margin="0,0,18,0" />
                        <StackPanel>
                            <TextBlock Text="{l:T License_CurrentOffer}" Style="{StaticResource PcsText.Muted}" />
                            <WrapPanel Margin="0,2,0,0">
                                <TextBlock Text="{Binding Offer}" Style="{StaticResource PcsText.HeroTitle}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <c:StatusChip Tone="{Binding StateTone}" Text="{Binding StateText}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Details}" Style="{StaticResource PcsText.Caption}" Margin="0,8,0,0"
                                       Visibility="{Binding Details, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Clé de licence : bouton principal -->
                <Border Style="{StaticResource PcsCard}" Padding="26,22" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T License_EnterKey}" Style="{StaticResource PcsText.SectionTitle}" />
                        <TextBlock Text="{l:T License_KeyHelp}" Style="{StaticResource PcsText.Muted}" Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource PcsInput}" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Tag="PCS-XXXXX-XXXXX-XXXXX-XXXXX"
                                     FontFamily="Consolas" MaxLength="40" FlowDirection="LeftToRight" AutomationProperties.Name="{l:T License_EnterKey}" />
                            <Button Grid.Column="1" Style="{StaticResource PcsButton.Primary}" MinHeight="44" c:Ui.Icon="{StaticResource PcsIcon.key}"
                                    Content="{l:T License_Activate}" Command="{Binding ActivateCommand}" Margin="12,0,0,0" />
                        </Grid>
                        <Border Style="{StaticResource PcsTile}" Margin="0,16,0,0" Visibility="{Binding OfferTransfer, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PcsButton.Secondary.Small}" Content="{l:T License_Transfer}"
                                        Command="{Binding TransferCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock Text="{l:T License_UsedElsewhereHelp}" Style="{StaticResource PcsText.Caption}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Ce PC -->
                <Border Style="{StaticResource PcsCard}" Padding="26,22" Margin="0,20,0,0" Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PcsButton.Secondary}" Content="{l:T Command_DeactivateLicense}"
                                Command="{Binding DeactivateCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{l:T License_ThisPc}" Style="{StaticResource PcsText.CardTitle}" />
                            <TextBlock Text="{l:T License_DeactivateHelp}" Style="{StaticResource PcsText.Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <v:BusyOverlay />
    </Grid>
</UserControl>
