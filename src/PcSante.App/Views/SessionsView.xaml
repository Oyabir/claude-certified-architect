<UserControl x:Class="PcSante.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:vm="clr-namespace:PcSante.App.ViewModels"
             xmlns:v="clr-namespace:PcSante.App.Views"
             xmlns:c="clr-namespace:PcSante.App.Controls">
    <!-- Sessions (§ 6.7) : une carte par session, message choisi dans une liste fermée, fermeture en bouton destructif. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="40,28,40,32">
                <DockPanel Margin="0,0,0,24">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PcsButton.Secondary}" c:Ui.Icon="{StaticResource PcsIcon.refresh}"
                            Content="{l:T Sessions_Refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PcsText.PageTitle}" />
                        <TextBlock Style="{StaticResource PcsText.Muted}" Margin="0,4,0,0">
                            <Run Text="{Binding Subtitle, Mode=OneWay}" /> <Run Text="{l:T Sessions_AdminNote}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Message (liste fermée : aucun texte libre n'est transmis au service) -->
                <Border Style="{StaticResource PcsCard.Small}" Margin="0,0,0,20">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" MinWidth="360" ItemsSource="{Binding Messages}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectedValue="{Binding SelectedMessage}" AutomationProperties.Name="{l:T Sessions_Message}" VerticalAlignment="Center" />
                        <c:IconTile DockPanel.Dock="Left" Icon="{StaticResource PcsIcon.alert-circle}" Size="40" IconSize="20" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{l:T Sessions_MessageCard}" Style="{StaticResource PcsText.CardTitle}" />
                            <TextBlock Text="{l:T Sessions_MessageHint}" Style="{StaticResource PcsText.Muted}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <c:EmptyState Icon="{StaticResource PcsIcon.check}" Text="{l:T Sessions_None}"
                              Visibility="{Binding Sessions.Count, Converter={StaticResource Collapsed}}" />
                <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SessionRow}">
                            <Border Style="{StaticResource PcsCard}" Padding="24,18" Margin="0,0,0,14">
                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PcsButton.Secondary.Small}" Content="{l:T Sessions_Send}" Margin="0,4,8,4"
                                                AutomationProperties.HelpText="{Binding User}"
                                                Command="{Binding DataContext.SendMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource PcsButton.Secondary.Small}" Content="{l:T Sessions_Disconnect}" Margin="0,4,8,4"
                                                AutomationProperties.HelpText="{Binding User}"
                                                Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource PcsButton.Danger.Small}" Content="{l:T Sessions_LogOff}" Margin="0,4,0,4"
                                                AutomationProperties.HelpText="{Binding User}"
                                                Command="{Binding DataContext.LogOffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource PcsBrandSoftBrush}" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PcsBrandTextBrush}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding User}" Style="{StaticResource PcsText.RowTitle}" Margin="0,0,10,0" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                            <c:StatusChip Tone="{Binding StateTone}" Text="{Binding State}" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource PcsText.Muted}" Margin="0,4,0,0">
                                            <Run Text="{Binding Origin, Mode=OneWay}" /> <Run Text="{Binding Since, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <v:BusyOverlay />
    </Grid>
</UserControl>
