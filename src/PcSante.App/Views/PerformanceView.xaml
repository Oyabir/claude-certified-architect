<UserControl x:Class="PcSante.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:PcSante.App.Localization"
             xmlns:vm="clr-namespace:PcSante.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="Metric" DataType="{x:Type vm:MetricSeries}">
            <ui:Card Margin="0,0,12,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Value}" FontSize="20" Margin="0,4,0,8" AutomationProperties.LiveSetting="Off" />
                    <Border Height="100" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="4" ClipToBounds="True">
                        <Viewbox Stretch="Fill">
                            <Canvas Width="300" Height="100">
                                <Polyline Points="{Binding Points}" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </ui:Card>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="4,0,12,24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
            <ui:Button Style="{StaticResource PrimaryAction}" HorizontalAlignment="Left" Content="{Binding OverlayButton}"
                       Icon="{ui:SymbolIcon Gauge24}" Command="{Binding ToggleOverlayCommand}" Margin="0,0,0,16" />
            <UniformGrid Columns="2">
                <ContentControl Content="{Binding Cpu}" ContentTemplate="{StaticResource Metric}" Focusable="False" />
                <ContentControl Content="{Binding Memory}" ContentTemplate="{StaticResource Metric}" Focusable="False" />
                <ContentControl Content="{Binding Disk}" ContentTemplate="{StaticResource Metric}" Focusable="False" />
                <ContentControl Content="{Binding Network}" ContentTemplate="{StaticResource Metric}" Focusable="False" />
            </UniformGrid>
            <UniformGrid Columns="2">
                <ui:Card Margin="0,0,12,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{l:T Metric_Temperature}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Temperature}" FontSize="20" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,12,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{l:T Metric_Battery}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Battery}" FontSize="20" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
